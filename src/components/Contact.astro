---
const contactDetails = [
  { label: 'Email',     val: 'oviedos412@gmail.com',  copy: true,  href: 'mailto:oviedos412@gmail.com' },
  { label: 'Teléfono',  val: '+54 9 376 450-9714',    copy: true  },
  { label: 'Ubicación', val: 'Posadas, Misiones, Argentina' },
];

const platforms = [
  { name: 'GitHub',   handle: 'github.com/santioviedo-dev',        href: 'https://github.com/santioviedo-dev' },
  { name: 'LinkedIn', handle: 'santiago-oviedo-analista',           href: 'https://www.linkedin.com/in/santiago-oviedo-analista/' },
];
---

<section
  id="contact"
  class="px-12 py-24 border-b border-line max-[900px]:px-6 max-[900px]:py-16"
>
  <div class="font-mono text-xs text-accent tracking-[0.15em] uppercase mb-12 flex items-center gap-4 after:flex-1 after:h-px after:bg-line">
    04 — Contacto
  </div>

  <h2 class="font-serif text-[clamp(2rem,3vw,2.8rem)] font-bold leading-[1.1] tracking-[-0.02em] mb-4">
    ¿Hablamos?
  </h2>

  <div class="grid grid-cols-2 gap-20 items-start mt-12 max-[900px]:grid-cols-1 max-[900px]:gap-12">
    <!-- Left -->
    <div>
      <p class="text-muted text-[0.95rem] mb-6">
        Estoy abierto a oportunidades en desarrollo backend, automatización o desarrollo fullstack.
        No dudes en escribirme.
      </p>

      {contactDetails.map(({ label, val, copy, href }) => (
        <div class="flex items-center gap-4 py-4 border-b border-line">
          <span class="font-mono text-xs text-muted tracking-[0.08em] min-w-[70px]">{label}</span>
          <span class="text-[0.9rem] text-text">
            {href
              ? <a href={href} class="text-text no-underline transition-colors duration-200 hover:text-accent">{val}</a>
              : val
            }
          </span>
          {copy && (
            <button
              onclick={`copyText('${val}')`}
              class="ml-auto bg-transparent border-none cursor-pointer text-muted font-mono text-[0.7rem]"
            >
              copiar
            </button>
          )}
        </div>
      ))}
    </div>

    <!-- Right: platforms -->
    <div class="flex flex-col gap-px bg-line">
      {platforms.map(({ name, handle, href }) => (
        <a
          href={href}
          target="_blank"
          class="bg-bg px-8 py-6 flex items-center justify-between no-underline transition-colors duration-200 hover:bg-bg2 group"
        >
          <div>
            <div class="font-mono text-[0.8rem] text-text tracking-[0.05em]">{name}</div>
            <div class="text-[0.8rem] text-muted">{handle}</div>
          </div>
          <span class="text-[0.9rem] text-line2 transition-all duration-200 group-hover:text-accent group-hover:translate-x-[3px] group-hover:-translate-y-[3px]">
            ↗
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Toast -->
<div
  id="toast"
  class="fixed bottom-8 right-8 bg-bg3 border border-line2 text-text font-mono text-[0.75rem] px-5 py-3 opacity-0 translate-y-2 transition-all duration-200 pointer-events-none z-[999]"
>
  ¡Copiado al portapapeles!
</div>

<script>
  function copyText(text: string) {
    navigator.clipboard.writeText(text).then(() => {
      const t = document.getElementById('toast')!;
      t.classList.add('opacity-100', 'translate-y-0');
      t.classList.remove('opacity-0', 'translate-y-2');
      setTimeout(() => {
        t.classList.remove('opacity-100', 'translate-y-0');
        t.classList.add('opacity-0', 'translate-y-2');
      }, 2000);
    });
  }
  // expose globally for onclick handlers
  (window as any).copyText = copyText;
</script>
