---
---
<section
  id="hero"
  class="min-h-screen grid grid-cols-2 items-center px-12 border-b border-line relative overflow-hidden max-[900px]:grid-cols-1 max-[900px]:px-6 max-[900px]:pt-28 max-[900px]:pb-16 max-[900px]:min-h-0"
>
  <!-- Grid lines decoration -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="
      background-image:
        linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px);
      background-size: 80px 80px;
      mask-image: radial-gradient(ellipse at 60% 50%, black 40%, transparent 70%);
    "
  ></div>

  <!-- Left: content -->
  <div class="relative z-10 pt-20 max-[900px]:pt-0">
    <div class="font-mono text-xs text-accent tracking-[0.1em] uppercase mb-6 flex items-center gap-[0.6rem]">
      <span class="inline-block w-[6px] h-[6px] rounded-full bg-[#3ecf8e]"></span>
      Disponible para trabajar
    </div>

    <h1 class="font-serif text-[clamp(3rem,5vw,4.5rem)] font-bold leading-[1.05] tracking-[-0.02em] mb-6">
      Santiago<br />
      <em class="italic text-accent font-light">Oviedo</em>
    </h1>

    <p class="text-[1.05rem] text-muted max-w-[440px] mb-10 leading-[1.8]">
      <strong class="text-text font-normal">Analista de Sistemas</strong> con foco en desarrollo
      backend y automatización. Construyo herramientas reales en Python que integran APIs, procesan
      datos y optimizan operaciones en producción.
    </p>

    <div class="flex gap-4 items-center">
      <a
        href="#projects"
        class="font-mono text-[0.8rem] px-7 py-3 bg-accent text-bg no-underline transition-opacity duration-200 hover:opacity-85 tracking-[0.05em]"
      >
        Ver proyectos
      </a>
      <a
        href="#contact"
        class="font-mono text-[0.8rem] px-7 py-3 bg-transparent text-muted border border-line2 no-underline transition-all duration-200 hover:text-text"
      >
        Contacto
      </a>
    </div>
  </div>

  <!-- Right: photo -->
  <div class="relative z-10 flex justify-end items-center pt-20 max-[900px]:justify-start max-[900px]:pt-12">
    <div class="relative w-[340px] h-[400px] max-[900px]:w-[240px] max-[900px]:h-[280px]">
      <!-- Accent border offset -->
      <div class="absolute top-4 left-4 w-full h-full border border-accent opacity-30"></div>
      <img
        src="/assets/img/my-photo.jpg"
        alt="Santiago Oviedo"
        class="w-full h-full object-cover object-top block relative z-10"
        style="filter: grayscale(20%)"
      />
      <div class="absolute -bottom-8 right-0 flex gap-4">
        {[
          { href: 'https://github.com/santioviedo-dev', label: 'GitHub ↗' },
          { href: 'https://www.linkedin.com/in/santiago-oviedo-analista/', label: 'LinkedIn ↗' },
        ].map(({ href, label }) => (
          <a
            href={href}
            target="_blank"
            class="font-mono text-[0.7rem] text-muted no-underline tracking-[0.05em] transition-colors duration-200 hover:text-accent"
          >
            {label}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
