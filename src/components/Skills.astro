---
const groups = [
  {
    title: 'Backend / Automatización',
    skills: [
      { label: 'Python', note: '— scripting, APIs, pipelines', bold: true },
      { label: 'APIs REST, OAuth2' },
      { label: 'SMTP / IMAP' },
      { label: 'Procesamiento CSV / Excel' },
      { label: 'Bash scripting' },
    ],
  },
  {
    title: 'Infraestructura',
    skills: [
      { label: 'Linux', note: '— Debian / Ubuntu', bold: true },
      { label: 'Proxmox (cluster 5 nodos)' },
      { label: 'pfSense, OpenVPN' },
      { label: 'Nginx / Apache' },
      { label: 'Zabbix, DNS, Samba' },
      { label: 'Google Workspace' },
    ],
  },
  {
    title: 'Desarrollo Web',
    skills: [
      { label: 'JavaScript / React / Node.js' },
      { label: 'PHP / Laravel' },
      { label: 'HTML / CSS' },
      { label: 'MySQL / PostgreSQL' },
      { label: 'Git' },
    ],
  },
];
---

<section
  id="skills"
  class="px-12 py-24 border-b border-line max-[900px]:px-6 max-[900px]:py-16"
>
  <div class="font-mono text-xs text-accent tracking-[0.15em] uppercase mb-12 flex items-center gap-4 after:flex-1 after:h-px after:bg-line">
    03 — Habilidades
  </div>

  <div class="grid grid-cols-3 gap-px bg-line mt-12 max-[900px]:grid-cols-1">
    {groups.map(({ title, skills }) => (
      <div class="bg-bg p-8">
        <div class="font-mono text-xs text-accent tracking-[0.12em] uppercase mb-5">{title}</div>
        <ul class="list-none">
          {skills.map(({ label, note, bold }) => (
            <li class="text-[0.875rem] text-muted py-[0.35rem] border-b border-line last:border-b-0 flex items-center gap-2">
              <span class="text-line2 text-xs">—</span>
              {bold ? <strong class="text-text font-normal">{label}</strong> : label}
              {note && <span>{note}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
